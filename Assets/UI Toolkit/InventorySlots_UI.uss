/* ===== INVENTORY MAIN CONTAINER ===== */
.inventory-main-container {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 280px;
    min-height: 120px;
    max-height: 400px;
    background-color: rgba(30, 30, 30, 0.9);
    border-width: 2px;
    border-color: rgba(100, 100, 100, 0.8);
    border-radius: 8px;
    padding: 8px;
    flex-direction: column;
}

/* ===== HEADER SECTION ===== */
.inventory-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    padding: 4px;
    background-color: rgba(50, 50, 50, 0.7);
    border-radius: 4px;
}

.inventory-title {
    font-size: 16px;
    color: rgb(220, 220, 220);
    -unity-font-style: bold;
}

.slot-count {
    font-size: 12px;
    color: rgb(180, 180, 180);
    -unity-font-style: normal;
}

/* ===== SCROLL VIEW ===== */
.inventory-scroll {
    flex-grow: 1;
    max-height: 320px;
}

/* ===== INVENTORY GRID ===== */
.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: flex-start;
    padding: 4px;
}

/* ===== INDIVIDUAL SLOT STYLES ===== */
.inventory-slot {
    width: 48px;
    height: 48px;
    margin: 2px;
    border-width: 1px;
    border-color: rgba(100, 100, 100, 0.6);
    border-radius: 4px;
    background-color: rgba(40, 40, 40, 0.8);
    position: relative;
    flex-shrink: 0;
}

.inventory-slot:hover {
    border-color: rgba(200, 200, 200, 1.0);
    background-color: rgba(60, 60, 60, 0.9);
}

.inventory-slot.occupied {
    background-color: rgba(70, 90, 70, 0.8);
    border-color: rgba(120, 200, 120, 0.8);
}

/* ===== SLOT CONTENT ===== */
.slot-icon {
    width: 100%;
    height: 100%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.slot-quantity {
    position: absolute;
    bottom: 2px;
    right: 2px;
    font-size: 10px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* ===== TOGGLE BUTTON ===== */
.toggle-button {
    width: 100%;
    height: 24px;
    margin-top: 4px;
    background-color: rgba(60, 60, 60, 0.8);
    border-width: 1px;
    border-color: rgba(100, 100, 100, 0.6);
    border-radius: 4px;
    color: rgb(200, 200, 200);
    font-size: 14px;
    -unity-font-style: bold;
}

.toggle-button:hover {
    background-color: rgba(80, 80, 80, 0.9);
    border-color: rgba(150, 150, 150, 0.8);
}

.toggle-button:active {
    background-color: rgba(40, 40, 40, 0.9);
}

/* ===== COLLAPSED STATE ===== */
.inventory-main-container.collapsed {
    min-height: 60px;
    max-height: 60px;
}

.inventory-main-container.collapsed .inventory-scroll {
    display: none;
}

/* ===== RESPONSIVE ADJUSTMENTS ===== */
@media (max-width: 800px) {
    .inventory-main-container {
        width: 240px;
        top: 10px;
        right: 10px;
    }
    
    .inventory-slot {
        width: 40px;
        height: 40px;
    }
}