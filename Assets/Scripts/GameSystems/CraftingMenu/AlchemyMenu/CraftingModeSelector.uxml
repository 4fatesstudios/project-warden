<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/GameSystems/CraftingMenu/AlchemyMenu/CraftingModeSelector.uss?fileID=7433441132597879392&amp;guid=d1c543adc83b6ef48ae5eff0c82058ef&amp;type=3#CraftingModeSelector" />
    <ui:VisualElement name="root" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.8); justify-content: center; align-items: center;">
        <ui:VisualElement name="main-mode-selection" style="background-color: rgba(50, 50, 50, 0.9); border-left-color: rgb(100, 100, 100); border-right-color: rgb(100, 100, 100); border-top-color: rgb(100, 100, 100); border-bottom-color: rgb(100, 100, 100); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; padding-left: 60px; padding-right: 60px; padding-top: 60px; padding-bottom: 60px; min-width: 800px; min-height: 600px;">
            <ui:Label text="Choose Crafting Mode" display-tooltip-when-elided="true" style="font-size: 48px; color: rgb(255, 255, 255); -unity-text-align: upper-center; margin-bottom: 40px; -unity-font-style: bold;" />
            <ui:VisualElement style="flex-direction: column; align-items: center; justify-content: center; flex-grow: 1;">
                <ui:Button text="🎨 Free Crafting" display-tooltip-when-elided="true" name="free-crafting-button" tooltip="Traditional 3x3 grid crafting with complete freedom" style="width: 600px; height: 120px; margin-bottom: 30px; font-size: 32px; background-color: rgba(80, 120, 200, 0.8); border-left-color: rgb(120, 150, 220); border-right-color: rgb(120, 150, 220); border-top-color: rgb(120, 150, 220); border-bottom-color: rgb(120, 150, 220); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-top-left-radius: 8px; border-bottom-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; color: rgb(255, 255, 255); -unity-font-style: bold;" />
                <ui:Button text="📜 Recipe Crafting" display-tooltip-when-elided="true" name="recipe-crafting-button" tooltip="Follow specific recipes with pre-designed obstacle patterns" style="width: 600px; height: 120px; margin-bottom: 30px; font-size: 32px; background-color: rgba(200, 120, 80, 0.8); border-left-color: rgb(220, 150, 120); border-right-color: rgb(220, 150, 120); border-top-color: rgb(220, 150, 120); border-bottom-color: rgb(220, 150, 120); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-top-left-radius: 8px; border-bottom-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; color: rgb(255, 255, 255); -unity-font-style: bold;" />
            </ui:VisualElement>
            <ui:Button text="← Back to Main Menu" display-tooltip-when-elided="true" name="back-button" style="width: 400px; height: 80px; align-self: center; margin-top: 40px; font-size: 24px; background-color: rgba(100, 100, 100, 0.8); border-left-color: rgb(150, 150, 150); border-right-color: rgb(150, 150, 150); border-top-color: rgb(150, 150, 150); border-bottom-color: rgb(150, 150, 150); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; color: rgb(255, 255, 255);" />
        </ui:VisualElement>
        <ui:VisualElement name="recipe-mode-panel" style="background-color: rgba(50, 50, 50, 0.9); border-left-color: rgb(100, 100, 100); border-right-color: rgb(100, 100, 100); border-top-color: rgb(100, 100, 100); border-bottom-color: rgb(100, 100, 100); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; padding-left: 60px; padding-right: 60px; padding-top: 60px; padding-bottom: 60px; min-width: 1200px; min-height: 1000px; display: none;">
            <ui:Label text="Select Recipe" display-tooltip-when-elided="true" style="font-size: 48px; color: rgb(255, 255, 255); -unity-text-align: upper-center; margin-bottom: 40px; -unity-font-style: bold;" />
            <ui:VisualElement style="flex-direction: row; flex-grow: 1;">
                <ui:VisualElement style="flex-basis: 60%; margin-right: 20px;">
                    <ui:Label text="Available Recipes:" style="font-size: 32px; color: rgb(255, 255, 255); margin-bottom: 20px; -unity-font-style: bold;" />
                    <ui:VisualElement style="flex-direction: row; margin-bottom: 20px; align-items: center;">
                        <ui:TextField name="recipe-search" placeholder-text="Search recipes..." style="flex-grow: 1; margin-right: 20px; font-size: 20px; height: 40px; padding-left: 10px; padding-right: 10px;" />
                        <ui:DropdownField name="difficulty-filter" style="width: 200px; font-size: 18px; height: 40px;" />
                    </ui:VisualElement>
                    <ui:ScrollView name="recipe-scroll-view" style="flex-grow: 1; background-color: rgba(30, 30, 30, 0.8); border-left-color: rgb(80, 80, 80); border-right-color: rgb(80, 80, 80); border-top-color: rgb(80, 80, 80); border-bottom-color: rgb(80, 80, 80); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; padding-left: 20px; padding-right: 20px; padding-top: 20px; padding-bottom: 20px; min-height: 600px;" />
                    <ui:Label name="recipe-count-label" text="" class="recipe-count-label" style="margin-top: 10px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-basis: 40%;">
                    <ui:Label text="Recipe Preview:" style="font-size: 32px; color: rgb(255, 255, 255); margin-bottom: 20px; -unity-font-style: bold;" />
                    <ui:VisualElement name="recipe-preview-container" style="flex-grow: 1; background-color: rgba(30, 30, 30, 0.8); border-left-color: rgb(80, 80, 80); border-right-color: rgb(80, 80, 80); border-top-color: rgb(80, 80, 80); border-bottom-color: rgb(80, 80, 80); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; padding-left: 30px; padding-right: 30px; padding-top: 30px; padding-bottom: 30px; min-height: 600px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="margin-top: 40px;">
                <ui:Label name="selected-recipe-label" text="Select a recipe to continue" style="font-size: 28px; color: rgb(255, 255, 255); -unity-text-align: upper-center; margin-bottom: 30px;" />
                <ui:VisualElement style="flex-direction: row; justify-content: center; align-items: center;">
                    <ui:Button text="← Back" display-tooltip-when-elided="true" name="recipe-back-button" style="width: 200px; height: 80px; margin-right: 40px; font-size: 24px; background-color: rgba(100, 100, 100, 0.8); border-left-color: rgb(150, 150, 150); border-right-color: rgb(150, 150, 150); border-top-color: rgb(150, 150, 150); border-bottom-color: rgb(150, 150, 150); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; color: rgb(255, 255, 255);" />
                    <ui:Button text="Start Crafting" display-tooltip-when-elided="true" name="confirm-recipe-button" style="width: 300px; height: 80px; font-size: 28px; background-color: rgba(80, 150, 80, 0.8); border-left-color: rgb(120, 180, 120); border-right-color: rgb(120, 180, 120); border-top-color: rgb(120, 180, 120); border-bottom-color: rgb(120, 180, 120); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; color: rgb(255, 255, 255); -unity-font-style: bold;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
