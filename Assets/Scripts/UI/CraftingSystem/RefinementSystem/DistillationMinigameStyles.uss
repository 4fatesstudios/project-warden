.main-container {
    flex-grow: 1;
    padding: 20px;
    background-color: rgb(30, 40, 50);
    background-image: url('project://database/Assets/UI/Textures/lab_background.png');
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(80, 100, 120);
}

.header-container {
    margin-bottom: 20px;
    align-items: center;
}

.title-label {
    font-size: 28px;
    color: rgb(200, 220, 240);
    margin-bottom: 10px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

.instructions-label {
    font-size: 16px;
    color: rgb(180, 200, 220);
    -unity-text-align: middle-center;
    white-space: normal;
}

.lab-area {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    margin: 20px 0;
}

.distillation-setup {
    flex-direction: row;
    align-items: flex-end;
    gap: 20px;
    height: 300px;
}

.boiling-flask {
    width: 100px;
    height: 120px;
    background-color: rgba(100, 100, 100, 0.8);
    border-radius: 10px 10px 50px 50px;
    border-width: 3px;
    border-color: rgb(150, 150, 150);
    position: relative;
    overflow: hidden;
}

.liquid-level {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 80%;
    background-color: rgba(100, 150, 200, 0.7);
    border-radius: 0 0 50px 50px;
    transition-duration: 0.5s;
}

.bubbles {
    position: absolute;
    bottom: 10px;
    left: 20px;
    width: 60px;
    height: 40px;
    background-image: url('project://database/Assets/UI/Textures/bubbles.png');
    opacity: 0;
}

.heat-source {
    position: absolute;
    bottom: -30px;
    width: 80px;
    height: 25px;
    background-color: rgb(255, 100, 0);
    border-radius: 40px;
    left: 10px;
}

.distillation-column {
    width: 30px;
    height: 150px;
    background-color: rgba(150, 150, 150, 0.9);
    border-radius: 15px;
    border-width: 2px;
    border-color: rgb(180, 180, 180);
    position: relative;
}

.steam-pipe {
    width: 100%;
    height: 100%;
    background-image: url('project://database/Assets/UI/Textures/steam_flow.png');
    background-repeat: repeat-y;
    opacity: 0;
    border-radius: 13px;
}

.condenser {
    width: 80px;
    height: 100px;
    background-color: rgba(120, 120, 120, 0.8);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(160, 160, 160);
    position: relative;
}

.cooling-coils {
    width: 60px;
    height: 80px;
    background-image: url('project://database/Assets/UI/Textures/cooling_coils.png');
    align-self: center;
    margin-top: 10px;
    background-color: rgba(100, 150, 200, 0.5);
    border-radius: 5px;
}

.collection-flask {
    width: 80px;
    height: 100px;
    background-color: rgba(100, 100, 100, 0.8);
    border-radius: 10px 10px 40px 40px;
    border-width: 3px;
    border-color: rgb(150, 150, 150);
    position: relative;
    overflow: hidden;
}

.distillate {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 0%;
    background-color: rgba(150, 200, 250, 0.8);
    border-radius: 0 0 40px 40px;
    transition-duration: 0.3s;
}

.controls-area {
    background-color: rgba(40, 50, 60, 0.9);
    padding: 20px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(80, 100, 120);
    gap: 15px;
}

.pressure-container, .progress-container {
    gap: 8px;
    position: relative;
}

.control-label {
    font-size: 14px;
    color: rgb(200, 220, 240);
    -unity-font-style: bold;
}

.pressure-gauge {
    height: 25px;
    background-color: rgb(60, 60, 60);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
}

.pressure-gauge .unity-progress-bar {
    background-color: rgb(100, 150, 255);
    border-radius: 10px;
    transition-duration: 0.2s;
}

.target-zone {
    position: absolute;
    left: 65%;
    top: 20px;
    width: 15%;
    height: 25px;
    background-color: rgba(0, 255, 0, 0.3);
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: rgb(0, 255, 0);
    border-radius: 3px;
}

.pressure-buttons {
    flex-direction: row;
    gap: 10px;
    margin-top: 5px;
}

.pressure-button {
    width: 40px;
    height: 30px;
    border-radius: 5px;
    border-width: 2px;
    font-size: 16px;
    -unity-font-style: bold;
}

.pressure-up {
    background-color: rgb(60, 120, 60);
    border-color: rgb(80, 140, 80);
    color: rgb(255, 255, 255);
}

.pressure-up:hover {
    background-color: rgb(80, 140, 80);
}

.pressure-down {
    background-color: rgb(120, 60, 60);
    border-color: rgb(140, 80, 80);
    color: rgb(255, 255, 255);
}

.pressure-down:hover {
    background-color: rgb(140, 80, 80);
}

.progress-bar {
    height: 20px;
    background-color: rgb(60, 60, 60);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
}

.progress-bar .unity-progress-bar {
    background-color: rgb(100, 200, 100);
    border-radius: 8px;
}

.status-container {
    align-items: center;
    margin-top: 10px;
}

.status-label {
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
}