.main-container {
    flex-grow: 1;
    padding: 20px;
    background-color: rgb(40, 30, 20);
    background-image: url('project://database/Assets/UI/Textures/kitchen_background.png');
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(100, 80, 60);
}

.header-container {
    margin-bottom: 20px;
    align-items: center;
}

.title-label {
    font-size: 28px;
    color: rgb(255, 240, 200);
    margin-bottom: 10px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

.instructions-label {
    font-size: 16px;
    color: rgb(220, 200, 180);
    -unity-text-align: middle-center;
    white-space: normal;
}

.cooking-area {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    margin: 20px 0;
    position: relative;
}

.fire-container {
    position: absolute;
    bottom: -20px;
    width: 150px;
    height: 80px;
    align-items: center;
    justify-content: flex-end;
}

.fire-flames {
    width: 120px;
    height: 60px;
    background-color: rgb(255, 140, 0);
    background-image: url('project://database/Assets/UI/Textures/fire_flames.png');
    border-radius: 50px 50px 10px 10px;
    opacity: 0.9;
}

.frying-pan {
    width: 200px;
    height: 150px;
    position: relative;
}

.pan-handle {
    position: absolute;
    right: -40px;
    top: 50px;
    width: 80px;
    height: 20px;
    background-color: rgb(60, 60, 60);
    border-radius: 10px;
}

.pan-base {
    width: 180px;
    height: 180px;
    background-color: rgb(40, 40, 40);
    border-radius: 90px;
    border-width: 8px;
    border-color: rgb(80, 80, 80);
    align-items: center;
    justify-content: center;
    position: relative;
}

.ingredient-sprite {
    width: 80px;
    height: 80px;
    background-image: url('project://database/Assets/UI/Textures/ingredient_placeholder.png');
    background-size: contain;
}

.steam-effect {
    position: absolute;
    top: -30px;
    width: 60px;
    height: 40px;
    background-color: rgba(255, 255, 255, 0.6);
    background-image: url('project://database/Assets/UI/Textures/steam.png');
    border-radius: 30px;
    opacity: 0;
}

.controls-area {
    background-color: rgba(50, 40, 30, 0.8);
    padding: 20px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(100, 80, 60);
    gap: 15px;
}

.temperature-container, .progress-container {
    gap: 8px;
}

.gauge-label {
    font-size: 14px;
    color: rgb(255, 240, 200);
    -unity-font-style: bold;
}

.temperature-gauge {
    height: 25px;
    background-color: rgb(60, 60, 60);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
}

.temperature-gauge .unity-progress-bar {
    background-color: rgb(0, 150, 255);
    border-radius: 10px;
    transition-duration: 0.2s;
}

.perfect-zone {
    position: absolute;
    left: 80%;
    top: 0;
    width: 10%;
    height: 100%;
    background-color: rgba(0, 255, 0, 0.3);
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: rgb(0, 255, 0);
}

.roasting-progress {
    height: 20px;
    background-color: rgb(60, 60, 60);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
}

.roasting-progress .unity-progress-bar {
    background-color: rgb(255, 140, 0);
    border-radius: 8px;
}

.status-container {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
}

.status-label {
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
}

.stop-button {
    width: 150px;
    height: 40px;
    background-color: rgb(180, 60, 60);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(220, 80, 80);
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
}

.stop-button:hover {
    background-color: rgb(200, 80, 80);
    border-color: rgb(240, 100, 100);
}

.stop-button:active {
    background-color: rgb(160, 40, 40);
    scale: 0.95;
}