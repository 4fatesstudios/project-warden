.main-container {
    flex-grow: 1;
    background-color: rgb(248, 248, 255); /* Ghost white background */
    padding: 20px;
    border-radius: 15px;
    border-width: 3px;
    border-color: rgb(147, 112, 219); /* Medium purple border */
}

.header-container {
    align-items: center;
    margin-bottom: 20px;
    padding: 15px;
    background-color: rgba(230, 230, 250, 0.9); /* Lavender background */
    border-radius: 10px;
}

.title-label {
    font-size: 28px;
    color: rgb(75, 0, 130); /* Indigo title */
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.instructions-label {
    font-size: 20px;
    color: rgb(138, 43, 226); /* Blue violet instructions */
    -unity-text-align: middle-center;
    margin-top: 5px;
}

.game-area {
    flex-direction: row;
    flex-grow: 1;
    margin-bottom: 20px;
}

.grid-container {
    flex: 2;
    align-items: center;
    justify-content: center;
    margin-right: 30px;
}

.crafting-grid {
    width: 400px;
    height: 400px;
    background-color: rgba(240, 240, 255, 0.9); /* Light periwinkle */
    border-radius: 10px;
    border-width: 3px;
    border-color: rgb(186, 85, 211); /* Medium orchid border */
}

.ingredient-queue {
    flex: 1;
    background-color: rgba(255, 240, 245, 0.9); /* Lavender blush */
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(221, 160, 221); /* Plum border */
    padding: 15px;
}

.queue-label {
    font-size: 20px;
    color: rgb(139, 69, 19); /* Saddle brown label */
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.queue-items {
    flex-grow: 1;
}

.controls-area {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-color: rgba(245, 245, 255, 0.9); /* Light lavender */
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(170, 130, 180); /* Medium purple border */
}

.score-container, .rank-container {
    align-items: center;
}

.score-label, .rank-label {
    font-size: 20px;
    color: rgb(75, 0, 130); /* Indigo labels */
    -unity-font-style: bold;
}

.score-value {
    font-size: 24px;
    color: rgb(72, 61, 139); /* Dark slate blue score */
    -unity-font-style: bold;
}

.rank-value {
    font-size: 32px;
    color: rgb(255, 140, 0); /* Dark orange rank */
    -unity-font-style: bold;
}

.button-container {
    flex-direction: row;
}

.action-button {
    width: 150px;
    height: 60px;
    border-radius: 8px;
    border-width: 2px;
    font-size: 20px;
    -unity-font-style: bold;
    transition-duration: 0.2s;
    margin-right: 15px;
}

.action-button {
    background-color: rgb(216, 191, 216); /* Thistle background */
    border-color: rgb(147, 112, 219); /* Medium purple border */
    color: rgb(75, 0, 130); /* Indigo text */
}

.action-button:hover {
    background-color: rgb(221, 160, 221); /* Plum on hover */
    scale: 1.05;
}

.action-button.primary {
    background-color: rgb(152, 251, 152); /* Pale green primary */
    border-color: rgb(50, 205, 50); /* Lime green border */
    color: rgb(0, 100, 0); /* Dark green text */
}

.action-button.primary:hover {
    background-color: rgb(144, 238, 144); /* Light green on hover */
}

.action-button.complete {
    background-color: rgb(255, 182, 193); /* Light pink complete */
    border-color: rgb(255, 105, 180); /* Hot pink border */
    color: rgb(139, 0, 139); /* Dark magenta text */
}

.action-button.complete:hover {
    background-color: rgb(255, 160, 122); /* Light salmon on hover */
}

.action-button:disabled {
    background-color: rgb(211, 211, 211); /* Light gray disabled */
    border-color: rgb(169, 169, 169); /* Dark gray border */
    color: rgb(105, 105, 105); /* Dim gray text */
}