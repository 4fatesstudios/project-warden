.menu-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
    background-color: rgb(255, 248, 220); /* Cornsilk background */
}

Button {
    font-size: 20px;
    width: 300px;
    height: 60px;
    -unity-font-style: bold;
    margin: 15px 0;
    background-color: rgb(255, 218, 185); /* Peach puff buttons */
    border-color: rgb(255, 165, 0); /* Orange border */
    border-width: 2px;
    border-radius: 8px;
    color: rgb(139, 69, 19); /* Saddle brown text */
}

Button:hover {
    background-color: rgb(255, 165, 0); /* Orange on hover */
    border-color: rgb(255, 140, 0); /* Dark orange border on hover */
}

Button:active {
    background-color: rgb(255, 140, 0); /* Dark orange when pressed */
}
