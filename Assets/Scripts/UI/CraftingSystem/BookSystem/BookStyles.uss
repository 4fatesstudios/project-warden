.book-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background-color: #eee;
}

.book-page-container {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    gap: 20px;
    width: 90%;
    height: 70%;
}

.book-page {
    flex-grow: 1;
    background-color: white;
    border-width: 2px;
    border-color: #444;
    border-radius: 8px;
    padding: 16px;
    overflow: hidden;
}

.book-nav {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
    width: 200px;
}

.book-button {
    width: 80px;
    height: 40px;
    font-size: 18px;
}
