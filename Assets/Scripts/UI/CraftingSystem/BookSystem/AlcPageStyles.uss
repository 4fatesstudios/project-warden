.bestiary-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
}

.bestiary-page {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 20px;
}

.entry-title {
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.creature-image {
    width: 150px;
    height: 150px;
    background-color: #ccc;
    margin-top: 10px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.entry-stat {
    font-size: 14px;
    -unity-text-align: middle-left;
    margin-right: 10px;
}

.entry-description {
    margin-top: 10px;
    font-size: 14px;
    -unity-text-align: middle-left;
}

.entry-subtitle {
    font-size: 16px;
    margin-top: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.entry-skill {
    font-size: 14px;
    margin-left: 10px;
    margin-top: 2px;
}

.stats-container {
    flex-direction: row;
    margin-top: 10px;
    margin-bottom: 10px;
}

.skills-container {
    flex-direction: column;
    margin-top: 4px;
}
