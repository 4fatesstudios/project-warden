/* Main Book Container */
.book-container {
    width: 800px;
    height: 600px;
    background-color: rgb(139, 115, 85);
    border-color: rgb(101, 67, 33);
    border-width: 3px;
    border-radius: 10px;
    padding: 20px;
    justify-content: center;
    align-items: center;
}

/* Cover Styles */
.cover {
    width: 100%;
    height: 100%;
    background-color: rgb(160, 130, 98);
    border-radius: 8px;
    justify-content: center;
    align-items: center;
    display: none;
}

.front-cover {
    background-image: url('project://database/Assets/UI/Images/book-cover.png');
}

.cover-title {
    font-size: 32px;
    color: rgb(218, 165, 32);
    -unity-font-style: bold;
    margin-bottom: 20px;
    text-align: center;
}

.cover-subtitle {
    font-size: 18px;
    color: rgb(139, 115, 85);
    text-align: center;
}

.cover-end-text {
    font-size: 24px;
    color: rgb(139, 115, 85);
    text-align: center;
}

/* Tab Navigation */
.tabs-container {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 10px;
    height: 40px;
}

.tab-button {
    width: 120px;
    height: 35px;
    margin-left: 2px;
    margin-right: 2px;
    background-color: rgb(160, 130, 98);
    border-color: rgb(101, 67, 33);
    border-width: 2px;
    border-radius: 8px 8px 0px 0px;
    color: rgb(101, 67, 33);
    font-size: 14px;
    -unity-font-style: bold;
}

.tab-button:hover {
    background-color: rgb(180, 150, 118);
}

.tab-active {
    background-color: rgb(245, 235, 220);
    color: rgb(101, 67, 33);
}

.bookmark-tab {
    width: 50px;
    font-size: 16px;
}

/* Search Container */
.search-container {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 15px;
    height: 30px;
}

.search-field {
    width: 300px;
    height: 25px;
    background-color: rgb(245, 235, 220);
    border-color: rgb(101, 67, 33);
    border-width: 1px;
    border-radius: 5px;
    padding-left: 10px;
    padding-right: 10px;
}

.search-button {
    width: 40px;
    height: 25px;
    margin-left: 5px;
    background-color: rgb(160, 130, 98);
    border-color: rgb(101, 67, 33);
    border-width: 1px;
    border-radius: 5px;
}

/* Pages Container */
.pages-container {
    flex-direction: row;
    flex-grow: 1;
    margin-bottom: 15px;
}

.page {
    width: 50%;
    height: 100%;
    background-color: rgb(245, 235, 220);
    border-color: rgb(139, 115, 85);
    border-width: 1px;
    padding: 20px;
    margin-left: 5px;
    margin-right: 5px;
}

.left-page {
    border-radius: 5px 0px 0px 5px;
}

.right-page {
    border-radius: 0px 5px 5px 0px;
}

/* Navigation */
.navigation-container {
    flex-direction: row;
    justify-content: space-between;
    height: 35px;
}

.nav-button {
    width: 120px;
    height: 30px;
    background-color: rgb(160, 130, 98);
    border-color: rgb(101, 67, 33);
    border-width: 2px;
    border-radius: 5px;
    color: rgb(101, 67, 33);
    font-size: 12px;
    -unity-font-style: bold;
}

.nav-button:hover {
    background-color: rgb(180, 150, 118);
}

/* Entry Styles */
.entry-container {
    width: 100%;
    padding: 10px;
    margin-bottom: 15px;
}

.entry-unseen {
    justify-content: center;
    align-items: center;
    background-color: rgb(200, 200, 200);
}

.entry-unknown {
    font-size: 48px;
    color: rgb(120, 120, 120);
    text-align: center;
}

.entry-title {
    font-size: 18px;
    color: rgb(101, 67, 33);
    -unity-font-style: bold;
    margin-bottom: 10px;
    text-align: center;
}

.entry-image {
    width: 100px;
    height: 100px;
    margin-bottom: 10px;
    border-color: rgb(139, 115, 85);
    border-width: 2px;
    align-self: center;
}

.entry-description {
    font-size: 12px;
    color: rgb(101, 67, 33);
    margin-bottom: 10px;
    white-space: normal;
}

.entry-bookmark {
    position: absolute;
    top: 0px;
    right: 10px;
    width: 20px;
    height: 30px;
    background-color: rgb(218, 165, 32);
}

/* Bestiary Specific Styles */
.bestiary-stats {
    background-color: rgb(220, 210, 195);
    padding: 10px;
    margin-bottom: 10px;
    border-radius: 5px;
}

.stat-label {
    font-size: 11px;
    color: rgb(101, 67, 33);
    margin-bottom: 3px;
}

.bestiary-aspects {
    margin-bottom: 10px;
}

.weakness-label {
    font-size: 11px;
    color: rgb(178, 34, 34);
    margin-bottom: 3px;
}

.resistance-label {
    font-size: 11px;
    color: rgb(34, 139, 34);
    margin-bottom: 3px;
}

.immunity-label {
    font-size: 11px;
    color: rgb(70, 130, 180);
    margin-bottom: 3px;
}

.bestiary-locations, .bestiary-skills {
    margin-bottom: 10px;
}

.location-label, .skills-title, .skill-label {
    font-size: 11px;
    color: rgb(101, 67, 33);
    margin-bottom: 2px;
}

/* Recipe Specific Styles */
.recipe-type {
    margin-bottom: 10px;
    align-items: center;
}

.unique-recipe {
    font-size: 14px;
    color: rgb(148, 0, 211);
    -unity-font-style: bold;
}

.custom-recipe {
    font-size: 14px;
    color: rgb(255, 140, 0);
    -unity-font-style: bold;
}

.recipe-ingredients, .recipe-infusions {
    background-color: rgb(220, 210, 195);
    padding: 8px;
    margin-bottom: 8px;
    border-radius: 3px;
}

.ingredients-title, .infusions-title {
    font-size: 12px;
    color: rgb(101, 67, 33);
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.ingredient-label, .infusion-label {
    font-size: 10px;
    color: rgb(101, 67, 33);
    margin-bottom: 2px;
}

.ingredient-unknown {
    font-size: 10px;
    color: rgb(150, 150, 150);
    margin-bottom: 2px;
}

/* Ingredient Specific Styles */
.ingredient-aspect {
    margin-bottom: 10px;
}

.aspect-label {
    font-size: 12px;
    color: rgb(101, 67, 33);
    -unity-font-style: bold;
}

.ingredient-sources, .ingredient-refinements, .ingredient-infusions {
    background-color: rgb(220, 210, 195);
    padding: 8px;
    margin-bottom: 8px;
    border-radius: 3px;
}

.sources-title, .refinements-title {
    font-size: 12px;
    color: rgb(101, 67, 33);
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.source-label, .refinement-label {
    font-size: 10px;
    color: rgb(101, 67, 33);
    margin-bottom: 2px;
}

.ingredient-corrupted {
    margin-bottom: 10px;
}

.corrupted-label {
    font-size: 11px;
    color: rgb(139, 0, 139);
    -unity-font-style: bold;
}

/* Help Specific Styles */
.help-content {
    padding: 15px;
}

.help-text {
    font-size: 12px;
    color: rgb(101, 67, 33);
    white-space: normal;
    line-height: 16px;
}
