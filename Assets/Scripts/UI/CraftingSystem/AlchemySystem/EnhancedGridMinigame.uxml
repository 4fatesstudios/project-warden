<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/GameSystems/CraftingMenu/AlchemyMenu/GridMinigameStyles.uss?fileID=7433441132597879392&amp;guid=&amp;type=3#GridMinigameStyles" />
    <ui:VisualElement name="MainContainer" class="main-container">
        <ui:VisualElement name="HeaderContainer" class="header-container">
            <ui:Label text="Alchemy Grid Crafting" name="TitleLabel" class="title-label" />
            <ui:Label text="🖱️ Drag ingredients from the left panel onto the grid, or click an ingredient then click a grid cell. Use Ctrl+Click to remove placed ingredients. Press Escape to go back, Ctrl+C to clear grid, Enter to craft." name="InstructionsLabel" class="instructions-label" />
            <ui:Button text="Back" name="BackButton" class="back-button" />
        </ui:VisualElement>
        
        <ui:VisualElement name="ContentContainer" class="content-container">
            <ui:VisualElement name="LeftPanel" class="left-panel">
                <ui:Label text="Ingredient Inventory" class="section-title" />
                <ui:ScrollView name="IngredientPalette" class="ingredient-palette">
                    <!-- Ingredient header row -->
                    <ui:VisualElement name="IngredientHeader" class="ingredient-header">
                        <ui:Label text="Name" class="header-name" />
                        <ui:Label text="Icon" class="header-icon" />
                        <ui:Label text="Qty" class="header-quantity" />
                    </ui:VisualElement>
                </ui:ScrollView>
                
                <ui:VisualElement name="StatusContainer" class="status-container">
                    <ui:Label text="Grid Status" class="section-title" />
                    <ui:Label text="Empty" name="GridStatusLabel" class="grid-status-label" />
                    <ui:Label text="No pattern matches" name="PatternMatchLabel" class="pattern-match-label" />
                    <ui:Label text="Recipe: None Selected" name="RecipeInfoLabel" class="recipe-info-label" />
                </ui:VisualElement>
                
                <ui:VisualElement name="AlchemyBookContainer" class="alchemy-book-container">
                    <ui:Button text="📖 Alchemy Book" name="AlchemyBookButton" class="alchemy-book-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <ui:VisualElement name="CenterPanel" class="center-panel">
                <ui:Label text="Crafting Grid" class="section-title" />
                <ui:VisualElement name="GridContainer" class="grid-container" />
                <ui:VisualElement name="GridInfoContainer" class="grid-info-container">
                    <ui:Label text="Efficiency: 0%" name="GridStatusLabel" class="grid-status-label" />
                    <ui:Label text="Interactions: 0" name="PatternMatchLabel" class="pattern-match-label" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <ui:VisualElement name="RightPanel" class="right-panel">
                <ui:Label text="Available Recipes" class="section-title" />
                <ui:ScrollView name="RecipeSelection" class="recipe-selection" />
                
                <ui:VisualElement name="CraftingControls" class="crafting-controls">
                    <ui:Button text="Clear Grid" name="ClearButton" class="clear-button" />
                    <ui:Button text="Craft Potion" name="CraftButton" class="craft-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>