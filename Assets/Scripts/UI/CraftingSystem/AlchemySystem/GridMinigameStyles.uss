.main-container {
    flex-grow: 1;
    padding: 20px;
    background-color: rgb(40, 40, 40);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
}

.header-container {
    margin-bottom: 20px;
}

.title-label {
    font-size: 24px;
    color: rgb(255, 255, 255);
    margin-bottom: 10px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.instructions-label {
    font-size: 14px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
    white-space: normal;
}

.content-container {
    flex-direction: row;
    flex-grow: 1;
}

.left-panel {
    width: 250px;
    background-color: rgb(50, 50, 50);
    padding: 15px;
    border-radius: 5px;
    margin-right: 20px;
}

.center-panel {
    flex-grow: 1;
    background-color: rgb(50, 50, 50);
    padding: 15px;
    border-radius: 5px;
    align-items: center;
    margin-right: 20px;
}

.section-title {
    font-size: 16px;
    color: rgb(255, 255, 255);
    margin-bottom: 10px;
    -unity-font-style: bold;
}

.ingredient-palette {
    max-height: 300px;
    margin-bottom: 20px;
}

.status-container {
    border-top-width: 1px;
    border-color: rgb(100, 100, 100);
    padding-top: 10px;
}

.status-label {
    font-size: 12px;
    color: rgb(180, 180, 180);
    white-space: normal;
}

.grid-container {
    background-color: rgb(30, 30, 30);
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    border-radius: 5px;
    padding: 10px;
    align-items: center;
    justify-content: center;
}

.button-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
}

.cancel-button {
    width: 120px;
    height: 40px;
    background-color: rgb(120, 60, 60);
    border-radius: 5px;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 14px;
}

.cancel-button:hover {
    background-color: rgb(140, 70, 70);
}

.confirm-button {
    width: 150px;
    height: 40px;
    background-color: rgb(60, 120, 60);
    border-radius: 5px;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 14px;
}

.confirm-button:hover {
    background-color: rgb(70, 140, 70);
}

.confirm-button:disabled {
    background-color: rgb(80, 80, 80);
    color: rgb(120, 120, 120);
}

.preview-cell {
    border-width: 2px;
    border-color: rgb(255, 255, 0);
}