.main-container {
    flex-grow: 1;
    padding: 20px;
    background-color: rgb(40, 40, 40);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    min-height: 400px;
}

.header-container {
    margin-bottom: 20px;
}

.title-label {
    font-size: 24px;
    color: rgb(255, 255, 255);
    margin-bottom: 10px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.instructions-label {
    font-size: 14px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 20px;
}

.content-container {
    flex-grow: 1;
    gap: 15px;
}

.recipe-selection, .quantity-section, .cost-section, .status-section {
    background-color: rgb(50, 50, 50);
    padding: 15px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(80, 80, 80);
}

.section-title {
    font-size: 16px;
    color: rgb(255, 255, 255);
    margin-bottom: 10px;
    -unity-font-style: bold;
}

.recipe-dropdown {
    width: 100%;
    height: 30px;
    background-color: rgb(60, 60, 60);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(100, 100, 100);
    color: rgb(255, 255, 255);
}

.quantity-field {
    width: 100px;
    height: 30px;
    background-color: rgb(60, 60, 60);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(100, 100, 100);
    color: rgb(255, 255, 255);
}

.cost-label {
    font-size: 14px;
    color: rgb(200, 200, 200);
    white-space: normal;
    min-height: 60px;
}

.status-label {
    font-size: 14px;
    color: rgb(180, 255, 180);
    -unity-font-style: bold;
}

.button-container {
    margin-top: 20px;
    align-items: center;
}

.bulk-craft-button {
    width: 200px;
    height: 50px;
    background-color: rgb(60, 120, 60);
    border-radius: 5px;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
}

.bulk-craft-button:hover {
    background-color: rgb(70, 140, 70);
}

.bulk-craft-button:disabled {
    background-color: rgb(80, 80, 80);
    color: rgb(120, 120, 120);
}

.result-container {
    margin-top: 20px;
    min-height: 60px;
}

.result-label {
    font-size: 14px;
    color: rgb(255, 255, 180);
    white-space: normal;
    -unity-text-align: middle-center;
    background-color: rgb(50, 50, 50);
    padding: 10px;
    border-radius: 5px;
}