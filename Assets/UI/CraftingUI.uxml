                                <ui:Label text="1 / 1" display-tooltip-when-elided="true" name="inv-page-number" class="page-number" />
                                <ui:Button text="▶" display-tooltip-when-elided="true" name="inv-page-next" class="page-arrow" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="filters" class="filters" style="align-self: auto; align-content: auto; align-items: auto; margin-bottom: 0; min-width: auto; width: 10%; justify-content: flex-start; position: relative; left: auto; top: auto; overflow: visible; visibility: visible; flex-direction: column; height: 100%; flex-shrink: 0; margin-left: 1%; margin-right: 0;">
                            <ui:Button text="🌍" display-tooltip-when-elided="true" name="filter-corporeal" tooltip="Corporeal" enable-rich-text="false" class="filter-tab" />
                            <ui:Button text="❄️" display-tooltip-when-elided="true" name="filter-frigid" tooltip="Frigid" class="filter-tab" />
                            <ui:Button text="🔥" display-tooltip-when-elided="true" name="filter-scorch" tooltip="Scorch" class="filter-tab" />
                            <ui:Button text="☣️" display-tooltip-when-elided="true" name="filter-caustic" tooltip="Caustic" class="filter-tab" />
                            <ui:Button text="⚡" display-tooltip-when-elided="true" name="filter-arc" tooltip="Arc" class="filter-tab" />
                            <ui:Button text="✨" display-tooltip-when-elided="true" name="filter-divine" tooltip="Divine" class="filter-tab" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="container-separator" class="container-separator" style="height: 3%; margin-top: 0; margin-bottom: 0;" />
                    <ui:VisualElement name="item-banner" class="item-banner" style="height: 20%; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%; color: rgb(240, 240, 240); background-color: rgba(55, 55, 55, 0); border-left-color: rgb(151, 149, 148); border-right-color: rgb(151, 149, 148); border-top-color: rgb(151, 149, 148); border-bottom-color: rgb(151, 149, 148); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
                        <ui:VisualElement name="item-info" class="item-info">
                            <ui:Label text="Select an ingredient" display-tooltip-when-elided="true" name="item-name" class="item-name" style="color: rgb(240, 240, 240);" />
                            <ui:Label text="Choose an ingredient from the grid above" display-tooltip-when-elided="true" name="item-description" class="item-description" style="color: rgb(240, 240, 240);" />
                        </ui:VisualElement>
