                                    <ui:VisualElement name="slot-row-3" class="slot-row" style="margin-bottom: 2%;">
                                        <ui:Button name="slot-8" class="ingredient-slot" style="margin-top: 2%; margin-right: 2%; margin-bottom: 2%; margin-left: 0%; width: 100px;">
                                            <ui:Label text="★" name="new-star-8" class="new-star" style="display: none;" />
                                        </ui:Button>
                                        <ui:Button name="slot-9" class="ingredient-slot" style="margin-top: 2%; margin-right: 2%; margin-bottom: 2%; margin-left: 2%;">
                                            <ui:Label text="★" name="new-star-9" class="new-star" style="display: none;" />
                                        </ui:Button>
                                        <ui:Button name="slot-10" class="ingredient-slot" style="margin-top: 2%; margin-right: 2%; margin-bottom: 2%; margin-left: 2%;">
                                            <ui:Label text="★" name="new-star-10" class="new-star" style="display: none;" />
                                        </ui:Button>
                                        <ui:Button name="slot-11" class="ingredient-slot" style="margin-top: 2%; margin-right: 0%; margin-bottom: 2%; margin-left: 2%;">
                                            <ui:Label text="★" name="new-star-11" class="new-star" style="display: none;" />
                                        </ui:Button>
