<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/CraftingUI.uss?fileID=7433441132597879392&amp;guid=3dde1ff1dcc277b418efde760cbd21c6&amp;type=3#CraftingUI" />
    <ui:VisualElement name="root" class="root-container" style="margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; padding-right: 4%; padding-left: 4%; border-left-color: rgb(199, 166, 106); border-left-width: 2px;">
        <ui:VisualElement name="root" class="root-container" style="margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; padding-right: 4%; padding-left: 4%; border-left-color: rgb(199, 166, 106); border-left-width: 20px; border-right-color: rgb(199, 166, 106); border-top-color: rgb(199, 166, 106); border-bottom-color: rgb(199, 166, 106); border-top-width: 20px; border-right-width: 20px; border-bottom-width: 20px;">
            <ui:VisualElement name="top-banner" class="top-banner" style="padding-top: 4%;">
                <ui:VisualElement name="top-buttons" class="top-buttons" style="margin-right: 0; margin-left: 0; height: 100%;">
                    <ui:Button text="💾" display-tooltip-when-elided="true" name="save-recipe-button" tooltip="Save to recipe book" class="circular-button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-direction: column;" />
                </ui:VisualElement>
                <ui:VisualElement name="top-buttons" class="top-buttons" style="margin-right: 0; margin-left: 0; height: 100%; flex-direction: column-reverse;">
                    <ui:Button text="📋" display-tooltip-when-elided="true" name="open-recipe-button" tooltip="Open recipe book" class="circular-button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                </ui:VisualElement>
                <ui:VisualElement name="top-buttons" class="top-buttons" style="margin-right: 0; margin-left: 0; height: 100%; align-self: auto; align-content: auto; flex-direction: column;">
                    <ui:Button text="🌟" display-tooltip-when-elided="true" name="skill-tree-button" tooltip="Open skill tree" class="circular-button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; justify-content: flex-start; flex-direction: column-reverse;" />
                </ui:VisualElement>
                <ui:Label text="CRAFTING" display-tooltip-when-elided="true" name="title" class="title" style="font-size: 72px;" />
                <ui:VisualElement name="top-buttons" class="top-buttons" style="margin-right: 0; margin-left: 0; display: flex; visibility: hidden; overflow: visible; opacity: 0;">
                    <ui:Button text="💾" display-tooltip-when-elided="true" name="save-recipe-button" tooltip="Save to recipe book" enabled="false" class="circular-button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                    <ui:Button text="💾" display-tooltip-when-elided="true" name="save-recipe-button" tooltip="Save to recipe book" enabled="false" class="circular-button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                    <ui:Button text="💾" display-tooltip-when-elided="true" name="save-recipe-button" tooltip="Save to recipe book" enabled="false" class="circular-button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="main-content" class="main-content" style="margin-right: 0%; margin-left: 0%; padding-top: 2%; padding-bottom: 6%; padding-right: 2%; padding-left: 2%;">
                <ui:VisualElement name="left-side" class="left-side">
                    <ui:VisualElement name="left-vertical-banner" class="left-vertical-banner" style="margin-right: 0%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%; width: 20%;">
                        <ui:Button text="🔄" display-tooltip-when-elided="true" name="clear-button" tooltip="Clear grid (Recipe mode: preserves obstacles)" class="round-button clear-button" style="width: 82%; height: 25%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; background-size: 100% 100%; background-color: rgba(199, 166, 106, 0); border-left-color: rgb(207, 207, 207); border-right-color: rgb(207, 207, 207); border-top-color: rgb(207, 207, 207); border-bottom-color: rgb(207, 207, 207); color: rgb(166, 165, 164);" />
                        <ui:VisualElement name="container-separator" class="container-separator" style="height: 8%; margin-top: 0; margin-bottom: 0;" />
                        <ui:Button text="🎒" display-tooltip-when-elided="true" name="inventory-button" tooltip="Toggle inventory display" class="round-button inventory-button" style="width: 82%; height: 25%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; background-size: 100% 100%; background-color: rgba(199, 166, 106, 0); border-left-color: rgb(207, 207, 207); border-right-color: rgb(207, 207, 207); border-top-color: rgb(207, 207, 207); border-bottom-color: rgb(207, 207, 207); color: rgb(171, 170, 169);" />
                    </ui:VisualElement>
                    <ui:VisualElement name="crafting-area" class="crafting-area" style="height: 100%; margin-left: 10%; margin-right: 10%; margin-bottom: 0%; padding-left: 10%; padding-top: 10%;">
                        <ui:VisualElement name="grid-frame" class="grid-frame" style="margin-bottom: 0%; align-items: stretch; width: 100%; height: 100%;">
                            <ui:VisualElement name="grid-viewport" class="grid-viewport" style="width: 100%;" />
                        </ui:VisualElement>
                        <ui:Button text="Complete" display-tooltip-when-elided="true" name="complete-button" tooltip="Craft the potion" selectable="true" class="complete-button" style="border-left-color: rgb(199, 166, 106); border-right-color: rgb(199, 166, 106); border-top-color: rgb(199, 166, 106); border-bottom-color: rgb(199, 166, 106); background-color: rgba(199, 166, 106, 0); color: rgb(199, 166, 106);" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="right-side" class="right-side" style="height: 115%;">
                    <ui:VisualElement name="right-container" class="right-container" style="margin-bottom: 0%; width: 100%; height: 100%; padding-top: 2%; flex-direction: column; flex-wrap: wrap; background-color: rgba(240, 240, 240, 0.95); border-left-color: rgb(200, 200, 200); border-right-color: rgb(200, 200, 200); border-top-color: rgb(200, 200, 200); border-bottom-color: rgb(200, 200, 200); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px;">
                        <ui:VisualElement name="advanced-filter-area" class="advanced-filter-area" style="width: 100%; height: 5%; margin-left: 0%; margin-bottom: 2%; margin-right: 0%; padding-top: 10px; align-items: center; flex-direction: row-reverse; justify-content: flex-start; border-left-color: rgba(200, 200, 200, 0); border-right-color: rgba(200, 200, 200, 0); border-top-color: rgba(200, 200, 200, 0); border-bottom-color: rgba(200, 200, 200, 0); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(220, 186, 126, 0); margin-top: 2%;">
                            <ui:TextField picking-mode="Ignore" placeholder-text="Search ingredients..." name="search-field" class="search-field" style="color: rgb(200, 200, 200); border-left-color: rgb(200, 200, 200); border-right-color: rgb(200, 200, 200); border-top-color: rgb(200, 200, 200); border-bottom-color: rgb(200, 200, 200); margin-right: 5%;" />
                            <ui:DropdownField text="Sort by: New" name="sort-dropdown" class="sort-dropdown" style="border-left-color: rgb(200, 200, 200); border-right-color: rgb(200, 200, 200); border-top-color: rgb(200, 200, 200); border-bottom-color: rgb(200, 200, 200); color: rgb(200, 200, 200);" />
                            <ui:Button text="🎒" display-tooltip-when-elided="true" name="inventory-toggle" tooltip="Toggle Inventory" class="inventory-toggle-button" style="flex-direction: column; overflow: visible; visibility: hidden; display: none;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="main-content-area" class="main-content-area" style="margin-right: 0%; margin-left: 0%; margin-top: 2%; height: 90%; width: 100%; flex-direction: column; align-items: center; align-self: center;">
                            <ui:VisualElement name="ingredient-grid-container" class="ingredient-grid-container" style="align-items: flex-start; flex-direction: column; align-content: auto; justify-content: center; padding-left: 5%;">
                                <ui:VisualElement name="slot-grid" class="slot-grid" style="margin-bottom: 4%; flex-direction: row; align-items: flex-start; justify-content: flex-start; align-self: auto; flex-wrap: wrap;">
                                    <ui:VisualElement name="slot-row-1" class="slot-row" style="margin-bottom: 2%;">
                                        <ui:Button name="slot-0" class="ingredient-slot" style="margin-top: 2%; margin-right: 2%; margin-bottom: 2%; margin-left: 0%;">
                                            <ui:Label text="★" name="new-star-0" class="new-star" style="display: none;" />
                                        </ui:Button>
                                        <ui:Button name="slot-1" class="ingredient-slot" style="margin-top: 2%; margin-right: 2%; margin-bottom: 2%; margin-left: 2%; color: rgb(230, 229, 229);">
                                            <ui:Label text="★" name="new-star-0" class="new-star" style="display: none;" />
                                        </ui:Button>
                                        <ui:Button name="slot-2" class="ingredient-slot" style="margin-top: 2%; margin-right: 2%; margin-bottom: 2%; margin-left: 2%;">
                                            <ui:Label text="★" name="new-star-0" class="new-star" style="display: none;" />
                                        </ui:Button>
                                        <ui:Button name="slot-3" class="ingredient-slot" style="margin-top: 2%; margin-right: 0%; margin-bottom: 2%; margin-left: 2%;">
                                            <ui:Label text="★" name="new-star-0" class="new-star" style="display: none;" />
                                        </ui:Button>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="slot-row-2" class="slot-row" style="margin-bottom: 2%;">
                                        <ui:Button name="slot-4" class="ingredient-slot" style="margin-top: 2%; margin-right: 2%; margin-bottom: 2%; margin-left: 0%;">
                                            <ui:Label text="★" name="new-star-4" class="new-star" style="display: none;" />
                                        </ui:Button>
                                        <ui:Button name="slot-5" class="ingredient-slot" style="margin-top: 2%; margin-right: 2%; margin-bottom: 2%; margin-left: 2%;">
                                            <ui:Label text="★" name="new-star-4" class="new-star" style="display: none;" />
                                        </ui:Button>
                                        <ui:Button name="slot-6" class="ingredient-slot" style="margin-top: 2%; margin-right: 2%; margin-bottom: 2%; margin-left: 2%;">
                                            <ui:Label text="★" name="new-star-4" class="new-star" style="display: none;" />
                                        </ui:Button>
                                        <ui:Button name="slot-7" class="ingredient-slot" style="margin-top: 2%; margin-right: 0%; margin-bottom: 2%; margin-left: 2%;">
                                            <ui:Label text="★" name="new-star-4" class="new-star" style="display: none;" />
                                        </ui:Button>
