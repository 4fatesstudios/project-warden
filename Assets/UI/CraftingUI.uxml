                            <ui:VisualElement name="page-controls" class="page-controls" style="align-self: center; align-content: center; align-items: center; flex-wrap: nowrap; margin-left: 0%; margin-right: 2%;">
                                <ui:Button text="&lt;&#10;" display-tooltip-when-elided="true" name="page-prev" class="page-arrow" style="border-left-color: rgba(179, 146, 86, 0); border-right-color: rgba(179, 146, 86, 0); border-top-color: rgba(179, 146, 86, 0); border-bottom-color: rgba(179, 146, 86, 0); background-color: rgba(199, 166, 106, 0); -unity-font-style: bold; font-size: 14%;" />
                                <ui:Label text="1 / 2" display-tooltip-when-elided="true" name="page-number" class="page-number" style="color: rgb(27, 27, 27);" />
                                <ui:Button text="&gt;&#10;" display-tooltip-when-elided="true" name="page-next" class="page-arrow" style="background-color: rgba(255, 255, 255, 0); border-left-color: rgba(179, 146, 86, 0); border-right-color: rgba(179, 146, 86, 0); border-top-color: rgba(179, 146, 86, 0); border-bottom-color: rgba(179, 146, 86, 0); -unity-font-style: bold; font-size: 14%;" />
