/* Ingredient Refining System Styles */

/* Main Container */
.refining-container {
    flex-direction: column;
    background-color: rgba(25, 30, 40, 0.95);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(120, 150, 180, 0.6);
    padding: 15px;
    margin: 5px;
}

/* Header */
.refining-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 15px;
    padding: 10px;
    background-color: rgba(35, 45, 60, 0.8);
    border-radius: 6px;
}

.refining-title {
    font-size: 20px;
    color: rgba(220, 230, 255, 1);
    -unity-font-style: bold;
}

.status-label {
    font-size: 20px;
    color: rgba(180, 200, 220, 0.9);
    background-color: rgba(15, 25, 40, 0.7);
    padding: 4px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(80, 120, 160, 0.5);
}

/* Ingredient List */
.ingredient-list {
    background-color: rgba(20, 25, 35, 0.9);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(80, 120, 160, 0.4);
    padding: 10px;
    margin-bottom: 10px;
    max-height: 300px;
}

.ingredient-item {
    flex-direction: column;
    background-color: rgba(30, 40, 55, 0.8);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(100, 130, 160, 0.3);
    padding: 8px;
    margin: 3px;
    transition-duration: 0.2s;
}

.ingredient-item:hover {
    background-color: rgba(40, 50, 70, 0.9);
    border-color: rgba(120, 150, 200, 0.6);
    scale: 1.02;
}

.ingredient-name {
    font-size: 20px;
    color: rgba(220, 230, 255, 1);
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.ingredient-archetype {
    font-size: 20px;
    color: rgba(160, 180, 200, 0.8);
    margin-bottom: 4px;
}

.ingredient-potency {
    font-size: 20px;
    color: rgba(180, 200, 220, 0.9);
    margin-bottom: 6px;
}

/* Refining Options */
.refining-options {
    flex-direction: row;
    flex-wrap: wrap;
}

.refining-options > * {
    margin-right: 4px;
    margin-bottom: 4px;
}

.refining-button {
    padding: 6px 10px;
    font-size: 20px;
    border-radius: 4px;
    border-width: 1px;
    margin: 1px;
    transition-duration: 0.2s;
    min-width: 120px;
}

.refining-grinding {
    background-color: rgba(120, 80, 60, 0.8);
    border-color: rgba(160, 120, 100, 0.7);
    color: rgba(255, 220, 200, 1);
}

.refining-grinding:hover {
    background-color: rgba(140, 100, 80, 1);
    border-color: rgba(180, 140, 120, 1);
    scale: 1.05;
}

.refining-distilling {
    background-color: rgba(60, 120, 160, 0.8);
    border-color: rgba(100, 160, 200, 0.7);
    color: rgba(220, 240, 255, 1);
}

.refining-distilling:hover {
    background-color: rgba(80, 140, 180, 1);
    border-color: rgba(120, 180, 220, 1);
    scale: 1.05;
}

.refining-roasting {
    background-color: rgba(160, 80, 60, 0.8);
    border-color: rgba(200, 120, 100, 0.7);
    color: rgba(255, 220, 200, 1);
}

.refining-roasting:hover {
    background-color: rgba(180, 100, 80, 1);
    border-color: rgba(220, 140, 120, 1);
    scale: 1.05;
}

.refining-button:disabled {
    background-color: rgba(60, 60, 60, 0.5);
    border-color: rgba(80, 80, 80, 0.5);
    color: rgba(120, 120, 120, 0.8);
    scale: 0.95;
}

/* Process Queue */
.process-queue {
    background-color: rgba(20, 25, 35, 0.9);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(80, 120, 160, 0.4);
    padding: 10px;
    margin-bottom: 10px;
    min-height: 100px;
}

.queue-title {
    font-size: 20px;
    color: rgba(200, 220, 240, 1);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.queue-item {
    flex-direction: row;
    align-items: center;
    background-color: rgba(40, 50, 65, 0.8);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(100, 130, 160, 0.3);
    padding: 6px;
    margin: 2px;
}

.queue-item-active {
    border-color: rgba(120, 200, 120, 0.8);
    background-color: rgba(40, 60, 40, 0.8);
}

.queue-item-label {
    color: rgba(200, 220, 240, 1);
    font-size: 20px;
    flex-grow: 1;
}

.queue-progress {
    width: 60px;
    height: 8px;
    background-color: rgba(60, 60, 60, 0.8);
    border-radius: 4px;
    margin-left: 8px;
}

.queue-progress-fill {
    height: 100%;
    background-color: rgba(120, 200, 120, 0.9);
    border-radius: 4px;
    transition-duration: 0.1s;
}

/* Active Processes */
.active-processes {
    background-color: rgba(20, 25, 35, 0.9);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(80, 120, 160, 0.4);
    padding: 10px;
    margin-bottom: 10px;
}

.process-item {
    flex-direction: row;
    align-items: center;
    background-color: rgba(40, 60, 40, 0.8);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(120, 180, 120, 0.6);
    padding: 8px;
    margin: 3px;
}

.process-item-label {
    color: rgba(220, 240, 220, 1);
    font-size: 20px;
    flex-grow: 1;
}

.process-timer {
    color: rgba(180, 220, 180, 0.9);
    font-size: 20px;
    min-width: 60px;
    -unity-text-align: middle-right;
}

/* Control Buttons */
.control-buttons {
    flex-direction: row;
    margin-top: 10px;
}

.control-buttons > * {
    margin-right: 10px;
}
}

.control-button {
    padding: 15px 24px;
    font-size: 20px;
    -unity-font-style: bold;
    border-radius: 6px;
    border-width: 2px;
    transition-duration: 0.2s;
}

.start-button {
    background-color: rgba(80, 160, 80, 0.9);
    border-color: rgba(120, 200, 120, 0.8);
    color: rgba(255, 255, 255, 1);
}

.start-button:hover {
    background-color: rgba(100, 180, 100, 1);
    border-color: rgba(140, 220, 140, 1);
    scale: 1.05;
}

.clear-button {
    background-color: rgba(160, 80, 80, 0.9);
    border-color: rgba(200, 120, 120, 0.8);
    color: rgba(255, 255, 255, 1);
}

.clear-button:hover {
    background-color: rgba(180, 100, 100, 1);
    border-color: rgba(220, 140, 140, 1);
    scale: 1.05;
}

.pause-button {
    background-color: rgba(160, 140, 80, 0.9);
    border-color: rgba(200, 180, 120, 0.8);
    color: rgba(255, 255, 255, 1);
}

.pause-button:hover {
    background-color: rgba(180, 160, 100, 1);
    border-color: rgba(220, 200, 140, 1);
    scale: 1.05;
}

/* Results Display */
.results-area {
    background-color: rgba(20, 25, 35, 0.9);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(80, 120, 160, 0.4);
    padding: 10px;
    margin-top: 10px;
    max-height: 150px;
}

.result-item {
    flex-direction: row;
    align-items: center;
    padding: 6px;
    margin: 2px;
    border-radius: 4px;
    border-width: 1px;
}

.result-success {
    background-color: rgba(40, 80, 40, 0.7);
    border-color: rgba(80, 160, 80, 0.6);
}

.result-critical {
    background-color: rgba(80, 60, 40, 0.7);
    border-color: rgba(200, 150, 80, 0.8);
}

.result-failed {
    background-color: rgba(80, 40, 40, 0.7);
    border-color: rgba(160, 80, 80, 0.6);
}

.result-lost {
    background-color: rgba(60, 40, 60, 0.7);
    border-color: rgba(120, 80, 120, 0.6);
}

.result-icon {
    font-size: 20px;
    margin-right: 8px;
}

.result-text {
    color: rgba(220, 230, 255, 1);
    font-size: 20px;
    flex-grow: 1;
}

/* Skill Display */
.skill-display {
    flex-direction: row;
    background-color: rgba(15, 20, 30, 0.8);
    border-radius: 4px;
    padding: 8px;
    margin-bottom: 10px;
}

.skill-display > * {
    margin-right: 15px;
}
}

.skill-item {
    flex-direction: column;
    align-items: center;
    min-width: 80px;
}

.skill-icon {
    font-size: 20px;
    margin-bottom: 4px;
}

.skill-name {
    font-size: 20px;
    color: rgba(180, 200, 220, 0.9);
    margin-bottom: 2px;
}

.skill-level {
    font-size: 20px;
    color: rgba(220, 240, 255, 1);
    -unity-font-style: bold;
}

/* Visual States - Using transitions instead of unsupported animations */

.process-item-active {
    scale: 1.02;
    border-color: rgba(120, 180, 120, 0.9);
    transition-duration: 0.5s;
    transition-property: scale, border-color;
}

.result-success {
    background-color: rgba(80, 160, 80, 0.9);
    transition-duration: 0.3s;
    transition-property: background-color;
}

.result-critical {
    border-color: rgba(255, 215, 0, 1);
    scale: 1.05;
    transition-duration: 0.3s;
    transition-property: scale, border-color;
}

/* Equipment Bonus Display */
.equipment-bonus {
    flex-direction: row;
    align-items: center;
    background-color: rgba(15, 20, 30, 0.8);
    border-radius: 4px;
    padding: 6px;
    margin-bottom: 8px;
}

.equipment-icon {
    font-size: 20px;
    margin-right: 6px;
    color: rgba(200, 180, 120, 1);
}

.equipment-text {
    font-size: 20px;
    color: rgba(180, 200, 220, 0.9);
    flex-grow: 1;
}

.equipment-bonus-value {
    font-size: 20px;
    color: rgba(120, 200, 120, 1);
    -unity-font-style: bold;
}

/* Responsive Design */
.refining-container.compact .ingredient-item {
    padding: 6px;
    margin: 2px;
}

.refining-container.compact .refining-button {
    padding: 6px 12px;
    font-size: 20px;
    min-width: 90px;
}

/* Dark Theme Support */
.dark-theme .refining-container {
    background-color: rgba(10, 15, 25, 0.98);
    border-color: rgba(80, 110, 140, 0.7);
}

.dark-theme .ingredient-item {
    background-color: rgba(15, 25, 40, 0.9);
}

.dark-theme .status-label {
    background-color: rgba(5, 15, 25, 0.9);
}