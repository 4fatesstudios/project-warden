/* Completed Potions List Styles */

.potions-panel {
    background-color: rgba(32, 48, 64, 0.95);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 8px;
    min-width: 220px;
    max-width: 280px;
    min-height: 300px;
    position: absolute;
    right: 10px;
    top: 10px;
    bottom: 10px;
    padding: 0;
    flex-direction: column;
}

.potions-header {
    background-color: rgba(48, 48, 48, 0.9);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    padding: 8px;
    min-height: 30px;
    justify-content: center;
    align-items: center;
}

.header-text {
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.potions-scroll-view {
    flex-grow: 1;
    padding: 5px;
}

.potions-content {
    flex-direction: column;
    padding: 0;
    margin: 0;
}

.potions-footer {
    background-color: rgba(48, 48, 48, 0.7);
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
    padding: 6px;
    min-height: 24px;
    justify-content: center;
    align-items: center;
}

.footer-text {
    color: rgba(255, 255, 255, 0.7);
    font-size: 10px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
}

/* Individual Potion Entry Styles */

.potion-entry {
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    margin-bottom: 4px;
    padding: 8px;
    min-height: 60px;
    transition-duration: 0.2s;
    flex-direction: column;
}

.potion-entry:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.4);
    scale: 1.02;
}

.potion-entry.crafted {
    background-color: rgba(76, 175, 80, 0.2);
    border-color: rgba(76, 175, 80, 0.5);
}

.potion-entry.crafted:hover {
    background-color: rgba(76, 175, 80, 0.3);
    border-color: rgba(76, 175, 80, 0.7);
}

.potion-entry.s-rank {
    background-color: rgba(255, 193, 7, 0.2);
    border-color: rgba(255, 193, 7, 0.5);
}

.potion-entry.s-rank:hover {
    background-color: rgba(255, 193, 7, 0.3);
    border-color: rgba(255, 193, 7, 0.7);
}

.potion-name {
    color: white;
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 2px;
    white-space: normal;
    text-overflow: ellipsis;
}

.potion-stats {
    color: rgba(255, 255, 255, 0.8);
    font-size: 11px;
    white-space: normal;
}

.potion-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    background-color: rgba(255, 193, 7, 0.9);
    color: black;
    font-size: 8px;
    -unity-font-style: bold;
    padding: 2px 4px;
    border-radius: 8px;
    min-width: 16px;
    -unity-text-align: middle-center;
}

.auto-craft-indicator {
    color: rgba(76, 175, 80, 1);
    font-size: 10px;
    -unity-font-style: bold;
}

/* Animation and Visual Effects */

.fade-in {
    opacity: 0;
    transition-duration: 0.3s;
}

.fade-in.visible {
    opacity: 1;
}

/* Responsive Design */

@media (max-width: 1600px) {
    .potions-panel {
        min-width: 180px;
        max-width: 220px;
    }
    
    .potion-name {
        font-size: 12px;
    }
    
    .potion-stats {
        font-size: 10px;
    }
}

/* Empty State */

.empty-state {
    padding: 20px;
    text-align: center;
    color: rgba(255, 255, 255, 0.5);
    font-size: 12px;
    -unity-font-style: italic;
}

.empty-state-icon {
    font-size: 24px;
    margin-bottom: 8px;
    color: rgba(255, 255, 255, 0.3);
}