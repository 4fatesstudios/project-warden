/* Minimal test USS file to isolate the issue */

.root-container {
    width: 100%;
    height: 100%;
    background-color: rgb(20, 15, 10);
}

.ingredient-slot {
    width: 100px;
    height: 100px;
    background-color: rgb(240, 240, 240);
    border-width: 2px;
    border-color: rgb(200, 200, 200);
    border-radius: 10px;
}

.item-banner {
    width: 100%;
    height: 80px;
    background-color: rgba(245, 235, 220, 0.95);
    border-radius: 10px;
    padding: 15px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.item-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(40, 30, 20);
    margin-bottom: 5px;
}

.item-description {
    font-size: 14px;
    color: rgb(80, 60, 40);
}

.rarity-badge {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border-width: 2px;
    border-color: rgb(60, 50, 40);
}